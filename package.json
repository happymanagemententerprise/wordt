{
  "name": "wordt",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "client-play",
    "client-tv"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -k -n server,play,tv -c magenta,cyan,yellow \"npm run dev --workspace @wordt/server\" \"npm run dev --workspace @wordt/client-play\" \"npm run dev --workspace @wordt/client-tv\"",
    "dev:server": "npm run dev --workspace @wordt/server",
    "dev:play": "npm run dev --workspace @wordt/client-play",
    "dev:tv": "npm run dev --workspace @wordt/client-tv",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "start": "npm run start --workspace @wordt/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
